** AUTHORED TEMPLATE — temp_sensor/temp_sweep (plan D-4): temperature sweep of a PTAT sensor.
** Sweeps the ambient temperature and extracts the output slope (dVout/dT, the sensor resolution),
** the 25 degC output, and the box-method spread (Vmax-Vmin)/Vavg/range over the range.
** Bindings: DUT PORT_LINE VDD, TSTART TSTOP TSTEP TLO THI, PDK_INCLUDE.
.lib cornerMOSlv.lib mos_tt
.temp 27

.param VDD=1.5

Vdd  vdd 0 dc {VDD}
Vss  vss 0 dc 0

XDUT vdd vout vss tsn_002_ptat_classic

.control
  set filetype=ascii
  dc temp -20 120 5
  meas dc v_out_25c FIND v(vout) AT=25
  meas dc v_lo  FIND v(vout) AT=-20
  meas dc v_hi  FIND v(vout) AT=120
  meas dc vmax  MAX v(vout) FROM=-20 TO=120
  meas dc vmin  MIN v(vout) FROM=-20 TO=120
  meas dc vavg  AVG v(vout) FROM=-20 TO=120
  let sens_v_per_c = (v_hi - v_lo) / (120 - (-20))
  print sens_v_per_c
  let tc_box_ppm = (vmax - vmin) / vavg / (120 - (-20)) * 1e6
  print tc_box_ppm
  write
  quit
.endc
.param x_dut_xm3_w=2.0u
.param x_dut_xm3_l=1.0u
.param x_dut_xm0_w=8.0u
.param x_dut_xm1_w=2.0u
.param x_dut_xm0_l=1.0u
