.include design.ngspice
.lib sm141064.ngspice typical
.temp 27

.param VDD=2.0

Vdd  vdd 0 dc {VDD}
Vss  vss 0 dc 0
Iload vout 0 dc 10m
CLoad vout 0 50p
Iac  vout 0 dc 0 ac 1

XDUT vdd vout vss ldo_003_analoggym_simple

.control
  set filetype=ascii
  ac dec 20 10 10meg
  meas ac zout_dc  FIND vdb(vout) AT=10
  meas ac zout_max MAX  vdb(vout)
  let zout_peak_db = zout_max - zout_dc
  print zout_peak_db
  write
  quit
.endc
.param x_dut_xm1_w=2u
