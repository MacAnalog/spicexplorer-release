# syntax=docker/dockerfile:1.7
# =============================================================================
# SpiceXplorer API — the FastAPI image. ONE app layer, TWO bases:
#
#   BASE_IMAGE=python:3.11-slim              (default) — lightweight, no
#       simulator. The app runs in replay/degraded mode (GET /api/env reports
#       pdk_ok:false, live_runs_enabled:false): the UI, score shaping,
#       compare/explore over cached checkpoints and the reference library all
#       work; live simulation does not.
#
#   BASE_IMAGE=spicexplorer-spice-base:release — the EDA runtime built by
#       Dockerfile.spice-base: ngspice (OSDI) + IHP sg13g2 / sky130 / gf180mcu
#       vendored. LIVE SPICE works with nothing installed on the host
#       (pdk_ok:true). Bring it up with `make up-live`.
#
# The app layer below is identical either way — only the FROM changes — so the
# two lanes can never drift apart. See docs/docker.md.
#
# Build context = repo root (needs platform/ + analog-db/).
#   docker compose build api      # or via `make up`
# =============================================================================
ARG BASE_IMAGE=python:3.11-slim
FROM ${BASE_IMAGE}

# uv for fast, lockless workspace resolution (CPU torch pinned in the platform
# pyproject's [tool.uv.index], so no CUDA wheels are pulled on linux).
COPY --from=ghcr.io/astral-sh/uv:0.10 /uv /uvx /bin/
# UV_PROJECT_ENVIRONMENT is pinned so the venv lands in the same place on both
# bases (spice-base puts /app/platform/.venv/bin on PATH for exactly this).
ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PROJECT_ENVIRONMENT=/app/platform/.venv

WORKDIR /app
# The analog-db corpus backs the /api/library routes; the platform is the uv
# workspace (the 6 released packages).
COPY analog-db/ ./analog-db/
COPY platform/  ./platform/

WORKDIR /app/platform
# Resolve + install the workspace (api + its closure) into platform/.venv, then
# borrow the analog-db corpus editable (no deps — it is not a workspace member).
RUN uv sync \
    && uv pip install --no-deps -e ../analog-db

ENV SPICEXPLORER_ANALOG_DB=/app/analog-db \
    LOG_LEVEL=INFO
EXPOSE 8000

# project_root() anchors on /app/platform/.spicexplorer-root; app_config.json is
# read from there. Run from the platform root so both resolve.
CMD ["uv", "run", "uvicorn", "spicexplorer_api.main:app", "--host", "0.0.0.0", "--port", "8000"]
