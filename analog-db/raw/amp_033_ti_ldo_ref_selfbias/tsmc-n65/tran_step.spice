* Each tied symbol is defined exactly once, by its line below; rewrite that
* .param to untie just that symbol (untying = shadowing, plan D-3).
.param x_dut_xm4_w = {x_dut_xm3_w}
.param x_dut_xm4_l = {x_dut_xm3_l}
.param x_dut_xm2_w = {x_dut_xm1_w}
.param x_dut_xm2_l = {x_dut_xm1_l}
.param x_dut_xmbc_l = {x_dut_xmb0_l}
.param x_dut_xmbo_l = {x_dut_xmb0_l}
.subckt amp_033_ti_ldo_ref_selfbias vdd vout vinp vinn vss
CC ncz vout 'c_comp'
RZ nb ncz 'r_z'
XM1 na vinn tail vss nch_lvt l=x_dut_xm1_l w=x_dut_xm1_w
XM2 nb vinp tail vss nch_lvt l=x_dut_xm2_l w=x_dut_xm2_w
XM3 na na vdd vdd pch_lvt l=x_dut_xm3_l w=x_dut_xm3_w
XM4 nb na vdd vdd pch_lvt l=x_dut_xm4_l w=x_dut_xm4_w
XM5 vout nb vdd vdd pch_lvt l=x_dut_xm5_l w=x_dut_xm5_w
XMB0 ibias ibias vss vss nch_lvt l=x_dut_xmb0_l w=x_dut_xmb0_w
XMBC tail ibias vss vss nch_lvt l=x_dut_xmbc_l m=x_dut_xmbc_m w=x_dut_xmbc_w
XMBO vout ibias vss vss nch_lvt l=x_dut_xmbo_l m=x_dut_xmbo_m w=x_dut_xmbo_w
XMBP ibias ibias vdd vdd pch_lvt l=x_dut_xmbp_l w=x_dut_xmbp_w
.ends
