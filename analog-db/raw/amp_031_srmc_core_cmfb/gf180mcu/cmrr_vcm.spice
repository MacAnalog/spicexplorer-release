.param x_dut_xm1_l=0.427751u
.param x_dut_xm2_w=1.59144u
.param x_dut_xm2_l=0.575725u
.param x_dut_c1_value=2.4e-12
.param x_dut_r1_value=10k
.param x_dut_rm1p_value=1Meg
.param gm_val=100u
.param rout_val=10Meg
