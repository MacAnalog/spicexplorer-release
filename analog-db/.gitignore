__pycache__/
*.pyc
.venv/
.pytest_cache/
*.raw
*.log
**/temp_spice_out/
# ephemeral `analog-db run` / raw-project working output — not catalog decks
raw/**/scratch/
# Translated Spectre run decks under raw/: raw/ holds the ngspice catalog decks ONLY. A .scs here is
# a machine-local by-product of driving a deck through the Spectre lane — it carries an ABSOLUTE
# `include` of a PDK model file (a release leak-scan DENY) and is never a catalog artifact.
# (Authored Spectre reference bindings live at circuits/*/spectre/** and stay tracked.)
raw/**/*.scs
.DS_Store


sandbox/*
# Local absolute-include deck copies: the committed raw/ decks reference PDK corner libs by
# BARE NAME (resolved on the ngspice sourcepath). `.include` does NOT search that path, so driving
# them through the optimizer natively needs copies with absolute paths — machine-specific, never committed.
raw_optimize/_abs/

# gm/ID LUTs are regenerable artifacts, not source. The canonical store is OUT-OF-REPO
# (~/.spicexplorer/gmid/<pdk>/, the gmid.out_root); rebuild with tools/regen_gmid_luts.py.
# See _shared/GMID.md. (Small offline test fixtures live in packages/spicexplorer-gmid/tests/.)
_shared/gmid/**/*.pkl
_shared/gmid/**/*.manifest.json
# ...but KEEP a small coarse-grid fixture set (open PDKs only, ~0.3-0.6 MB each) tracked, so the
# reader tests (gmid.lut / list_luts / manifest) have real data in a fresh checkout / CI. These are
# the low-resolution tables; the full max-fidelity store stays out-of-repo.
!_shared/gmid/sky130/sky130_fd_pr__nfet_01v8__tt.pkl
!_shared/gmid/sky130/sky130_fd_pr__nfet_01v8__tt.manifest.json
!_shared/gmid/sky130/sky130_fd_pr__pfet_01v8__tt.pkl
!_shared/gmid/sky130/sky130_fd_pr__pfet_01v8__tt.manifest.json
!_shared/gmid/ihp-sg13g2/sg13_lv_nmos__tt.pkl
!_shared/gmid/ihp-sg13g2/sg13_lv_nmos__tt.manifest.json
!_shared/gmid/ihp-sg13g2/sg13_lv_pmos__tt.pkl
!_shared/gmid/ihp-sg13g2/sg13_lv_pmos__tt.manifest.json

# PAM-4 HBT layout flow (drawings/*/ported-netlists/layout): regenerable outputs of
# gen_layout.py / signoff.py / kpex. Track only small text artifacts (converted
# post-layout netlists directly under pex/, LVS/kpex/sim netlists, PNG renders,
# pex_report.yaml); GDS and the DRC/LVS/PEX working dirs rebuild deterministically.
drawings/*/ported-netlists/layout/out/*.gds
drawings/*/ported-netlists/layout/out/pex/*/
drawings/*/ported-netlists/layout/out/signoff/
drawings/*/ported-netlists/notebooks/nb_opt/
.kpex_cache/
# stray LVS by-products dumped into cwd by KLayout LVS runs
*_lay_extracted.cir

# Same PAM-4 HBT layout flow, now landed under the VERSIONED circuit entries
# (circuits/<id>/pdk/<pdk>/layout-<NNN>-<slug>/ — see that dir's layout.yaml).
# Identical policy: track the generator/signoff/pex code + small text artifacts
# (converted post-layout netlists directly under pex/, the LVS/kpex/sim
# netlists, PNG renders, pex_report.yaml, layout.yaml, best_*.json); the GDS and
# the DRC/LVS/PEX/optimizer WORKING dirs rebuild deterministically from source.
circuits/*/pdk/*/layout-*/out/*.gds
circuits/*/pdk/*/layout-*/out/pex/*/
circuits/*/pdk/*/layout-*/out/signoff/
# optimizer per-trial working dirs (GDS/pex) are ignored; the small run records
# directly under the dir (best_<dut>.json, trials_<dut>.jsonl) stay tracked.
circuits/*/pdk/*/layout-*/opt_out/*/
circuits/*/pdk/*/layout-*/cosize_out/*/
