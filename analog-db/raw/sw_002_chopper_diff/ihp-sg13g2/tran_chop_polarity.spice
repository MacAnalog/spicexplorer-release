.lib cornerMOSlv.lib mos_tt
.temp 27

.param VDD=1.2
.param VCM=0.6
.param VD=0.2
.param RLOAD=100k
.param FCHOP=5k
.param TCHOP={1/FCHOP}
.param TEDGE=200n

Vdd  vdd 0 dc {VDD}
Vss  vss 0 dc 0
Vcm  vcm 0 dc {VCM}
Vap  va_p 0 dc {VCM+VD/2}
Van  va_n 0 dc {VCM-VD/2}
Rlp  vb_p vcm {RLOAD}
Rln  vb_n vcm {RLOAD}
Vck  vctl     0 pulse(0 {VDD} 0 {TEDGE} {TEDGE} {TCHOP/2-TEDGE} {TCHOP})
Vckn vctl_not 0 pulse({VDD} 0 0 {TEDGE} {TEDGE} {TCHOP/2-TEDGE} {TCHOP})

XDUT va_p va_n vb_p vb_n vctl vctl_not vdd vss sw_002_chopper_diff

.control
  set filetype=ascii
  tran 200n 1m
  let vbd = v(vb_p) - v(vb_n)
  meas tran v_fwd FIND vbd AT=850u
  meas tran v_rev FIND vbd AT=950u
  let chop_inversion = v_rev/v_fwd
  print chop_inversion
  write
  quit
.endc
.param x_dut_xm1_w=2u
.param x_dut_xm1_l=0.13u
.param x_dut_xm2_w=2u
.param x_dut_xm2_l=0.13u
.param x_dut_xm1_m=1
.param x_dut_xm2_m=1
