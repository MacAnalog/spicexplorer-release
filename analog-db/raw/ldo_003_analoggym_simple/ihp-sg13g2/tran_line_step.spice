.param x_dut_xmp_w=20u
.param x_dut_xmp_l=0.4u
.param x_dut_xmp_m=180
.param r_z=500
.param c_comp=60p
.param vref_val=1.8
.param vb_val=1.0
.param r_bleed=27k
