.lib sky130.lib.spice tt
.temp 27

.param VDD=1.5
.param VCM=0.75
.param VOD=0.05

Vdd  vdd 0 dc {VDD}
Vss  vss 0 dc 0
Vinp vinp 0 dc {VCM+VOD/2}
Vinn vinn 0 dc {VCM-VOD/2}
Vclk clk 0 dc 0 pulse(0 {VDD} 10n 1n 1n 50n 100n)

XDUT vdd voutp voutn vinp vinn clk vss cmp_002_strongarm

.control
  set filetype=ascii
  let vmid = 1.5/2
  tran 50p 250n
  meas tran t_prop TRIG v(clk) VAL=vmid RISE=2 TARG v(voutp) VAL=vmid RISE=2
  meas tran v_out_high FIND v(voutp) AT=150n
  meas tran v_out_low  FIND v(voutn) AT=150n
  meas tran i_avg AVG i(Vdd) FROM=10n TO=250n
  let i_supply = abs(i_avg)
  print t_prop i_supply
  write
  quit
.endc
