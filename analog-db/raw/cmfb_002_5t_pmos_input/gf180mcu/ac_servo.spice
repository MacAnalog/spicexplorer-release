.include design.ngspice
.lib sm141064.ngspice noise_corner
.lib sm141064.ngspice nfet_03v3_t
.lib sm141064.ngspice pfet_03v3_t
.lib sm141064.ngspice fets_mm
.lib sm141064.ngspice res_typical
.lib sm141064.ngspice mimcap_typical
.lib sm141064.ngspice cap_mim
.temp 27

.param VDD=1.2
.param VCM=0.5
.param CL=50f

Vdd  vdd 0 dc {VDD}
Vss  vss 0 dc 0
Vref vref 0 dc {VCM}
Vcm  vcm 0 dc {VCM} ac 1
* common-mode drive: both inputs follow the same AC source
Vinp vinp vcm dc 0
Vinn vinn vcm dc 0
CLoad vcmfb 0 {CL}

XDUT vinp vinn vcmfb vref vdd vss cmfb_002_5t_pmos_input

.control
  set filetype=ascii
  ac dec 61 10 1G
  let gdb = db(v(vcmfb))
  meas ac gain_servo_db FIND gdb AT=10
  let g3 = gain_servo_db - 3
  meas ac bw_servo_hz WHEN gdb=g3 FALL=1
  meas ac ugf_servo_hz WHEN gdb=0 FALL=1
  write
  quit
.endc
.param x_dut_xm4_w=1.42u
.param x_dut_xm4_l=0.28u
.param x_dut_xm2_w=2.32u
.param x_dut_xm2_l=1.31u
.param x_dut_xm1_w=0.329u
.param x_dut_xm1_l=0.28u
.param x_dut_xm7_w=0.293u
.param x_dut_xm7_l=0.28u
.param x_dut_xm3_w=0.881u
.param x_dut_xm3_l=0.28u
.param x_dut_rmp_value=1Meg
.param x_dut_xm1_m=1
.param x_dut_xm2_m=1
.param x_dut_xm3_m=1
.param x_dut_xm4_m=1
.param x_dut_xm7_m=1
