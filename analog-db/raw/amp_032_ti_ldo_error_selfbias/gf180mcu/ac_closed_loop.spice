  ac dec 101 1k 1G
  meas ac gain_cl FIND vmag(vout) AT=1k
  let g3db = gain_cl/sqrt(2)
  meas ac bw_cl WHEN vmag(vout)=g3db FALL=1
  write
  quit
.endc
