.lib cornerMOShv.lib mos_tt
.lib cornerRES.lib res_typ
.temp 27

Vdd  vdd 0 pulse(1.95 2.15 5u 100n 100n 20u 50u)
Vss  vss 0 dc 0
Iload vout 0 dc 10m
CLoad vout 0 50p

XDUT vdd vout vss ldo_003_analoggym_simple

.control
  set filetype=ascii
  tran 10n 45u
  meas tran vout_max MAX v(vout) from=5u to=45u
  meas tran vout_min MIN v(vout) from=5u to=45u
  let v_line_pp = vout_max - vout_min
  print v_line_pp
  write
  quit
.endc
.param x_dut_xm1_w=160u
.param x_dut_xm1_l=0.45u
.param x_dut_xm4_w=160u
.param x_dut_xm4_l=0.45u
