.lib cornerMOSlv.lib mos_tt
.temp 27

.param VDD=1.5
.param IBIAS=20u

Vdd  vdd 0 dc {VDD}
Vss  vss 0 dc 0
Ibias ibias vss dc {IBIAS}
Lfb  vout vin 1T              ; 1 TH: DC short — self-bias at the trip point

XDUT vdd vout vin ibias vss gs_001_cascode_cs

.control
  set filetype=ascii
  op
  let i_supply = abs(i(Vdd))
  let v_trip = v(vout)
  print i_supply v_trip
  write
  quit
.endc
