.subckt ia_001_hsu_bandpass_classab vinp vinn voutp voutn vdd vss
C1 flt_p zc_p 'x_dut_c1_value'
C2 flt_n zc_n 'x_dut_c2_value'
CF1 sum_p voutp 'x_dut_cf1_value'
CF2 voutn sum_n 'x_dut_cf2_value'
CIN1 vinn sum_p 'x_dut_cin1_value'
CIN2 vinp sum_n 'x_dut_cin2_value'
CISRV vcm_sense vcmfb_ref 'cin_val'
COSRV vss vcmfb 'cout_val'
GSRV vss vcmfb vcmfb_ref vcm_sense {gm_val}
R1 zc_p out1p 'x_dut_r1_value'
R2 out1n zc_n 'x_dut_r2_value'
