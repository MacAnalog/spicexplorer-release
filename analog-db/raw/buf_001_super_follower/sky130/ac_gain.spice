.lib sky130.lib.spice tt
.temp 27

.param VDD=1.5
.param VCM=1.05
.param IBIAS=10u
.param CL=500f

Vdd  vdd 0 dc {VDD}
Vss  vss 0 dc 0
Ibias vdd ibias dc {IBIAS}
Vin  vin 0 dc {VCM} ac 1
CLoad vout 0 {CL}

XDUT vdd vout vin ibias vss buf_001_super_follower

.control
  set filetype=ascii
  ac dec 20 100 10G
  meas ac gain_ac_db FIND vdb(vout) AT=100
  let gtarget = gain_ac_db - 3
  meas ac f3db_hz WHEN vdb(vout)=gtarget FALL=1
  write
  quit
.endc
