.subckt dp_001_resistive_load vdd voutp voutn vinp vinn ibias vss
RN vdd voutn x_dut_rn_value
RP vdd voutp x_dut_rp_value
XMN voutn vinn tail vss sg13_lv_nmos l=x_dut_xmn_l m=x_dut_xmn_m w=x_dut_xmn_w
XMP voutp vinp tail vss sg13_lv_nmos l=x_dut_xmp_l m=x_dut_xmp_m w=x_dut_xmp_w
XMR ibias ibias vss vss sg13_lv_nmos l=x_dut_xmr_l m=x_dut_xmr_m w=x_dut_xmr_w
XMT tail ibias vss vss sg13_lv_nmos l=x_dut_xmt_l m=x_dut_xmt_m w=x_dut_xmt_w
